// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`applyPatches > throws when \`op\` is not "add", "replace", nor "remove" 1`] = `[Error: Unsupported patch operation: copy.]`;

exports[`applyPatches > throws when \`path\` cannot be resolved 1`] = `[Error: Cannot apply patch at 'a/b'.]`;

exports[`applyPatches > throws when \`path\` cannot be resolved 2`] = `[Error: Cannot apply patch at 'a/b/c'.]`;
