{
  "schemaVersion": 1,
  "immerVersion": "11.1.18",
  "v1Version": "1.3.0",
  "arraySize": 1000,
  "latencyRuns": 5,
  "memoryRuns": 3,
  "memoryIterations": 16,
  "samplingInterval": 1024,
  "freezes": [false, true],
  "patches": [false, true],
  "latency": { "maxRatio": 1.3, "minimumDeltaNs": 500 },
  "allocation": { "maxRatio": 1.35, "minimumDeltaBytes": 8192 },
  "retainedHeap": { "maxRatio": 1.35, "minimumDeltaBytes": 1024 },
  "latencyScenarios": [
    "small-object-update",
    "read-index",
    "mutation-density-100pct",
    "array-shift-nested",
    "array-unshift-nested",
    "array-splice-insert-nested",
    "array-reverse-nested",
    "array-reverse-primitive"
  ],
  "memoryScenarios": ["mutation-density-100pct", "array-reverse-nested"]
}
