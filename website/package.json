{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/write-redirects.mjs && node scripts/check-links.mjs",
    "start": "serve out",
    "deploy": "pnpm build && gh-pages --dist out --nojekyll --repo git@github.com:unadlib/mutative.git --message \"Deploy website - based on $(git rev-parse HEAD)\"",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "feed": "^6.0.0",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
